    <h1>SQL Interview Test Answers</h1>

    <h2>Question 1: Difference Between DBMS and RDBMS</h2>

    <table border="1" cellpadding="8">
        <tr>
            <th>DBMS</th>
            <th>RDBMS</th>
        </tr>
        <tr>
            <td>Stores data as files.</td>
            <td>Stores data in tables.</td>
        </tr>
        <tr>
            <td>No relationship between data.</td>
            <td>Supports relationships using Primary Key and Foreign Key.</td>
        </tr>
        <tr>
            <td>Less secure.</td>
            <td>More secure.</td>
        </tr>
        <tr>
            <td>Examples: FoxPro, dBase.</td>
            <td>Examples: MySQL, Oracle, SQL Server.</td>
        </tr>
    </table>

    <hr>

    <h2>Question 2: DDL, DML, DQL, DCL and TCL</h2>

    <table border="1" cellpadding="8">
        <tr>
            <th>Command</th>
            <th>Purpose</th>
            <th>Example</th>
        </tr>

        <tr>
            <td>DDL</td>
            <td>Defines database structure.</td>
            <td>CREATE TABLE Employees(id INT);</td>
        </tr>

        <tr>
            <td>DML</td>
            <td>Manipulates data.</td>
            <td>INSERT INTO Employees VALUES(1,'Rahul');</td>
        </tr>

        <tr>
            <td>DQL</td>
            <td>Retrieves data.</td>
            <td>SELECT * FROM Employees;</td>
        </tr>

        <tr>
            <td>DCL</td>
            <td>Controls permissions.</td>
            <td>GRANT SELECT ON Employees TO user1;</td>
        </tr>

        <tr>
            <td>TCL</td>
            <td>Manages transactions.</td>
            <td>COMMIT;</td>
        </tr>
    </table>

    <hr>

    <h2>Question 3: Create Database and Table</h2>

<pre>
CREATE DATABASE CompanyDB;

USE CompanyDB;

CREATE TABLE Employees(
id INT PRIMARY KEY,
name VARCHAR(50),
department VARCHAR(50),
salary INT,
city VARCHAR(50)
);
</pre>

    <hr>

    <h2>Question 4: DELETE vs TRUNCATE vs DROP</h2>

    <table border="1" cellpadding="8">
        <tr>
            <th>DELETE</th>
            <th>TRUNCATE</th>
            <th>DROP</th>
        </tr>

        <tr>
            <td>Deletes selected rows.</td>
            <td>Deletes all rows.</td>
            <td>Deletes the entire table.</td>
        </tr>

        <tr>
            <td>WHERE can be used.</td>
            <td>WHERE cannot be used.</td>
            <td>Table no longer exists.</td>
        </tr>

        <tr>
            <td>DELETE FROM Employees WHERE id=1;</td>
            <td>TRUNCATE TABLE Employees;</td>
            <td>DROP TABLE Employees;</td>
        </tr>
    </table>

    <hr>

    <h2>Question 5: CHAR vs VARCHAR</h2>

    <table border="1" cellpadding="8">
        <tr>
            <th>CHAR</th>
            <th>VARCHAR</th>
        </tr>

        <tr>
            <td>Fixed length.</td>
            <td>Variable length.</td>
        </tr>

        <tr>
            <td>Faster.</td>
            <td>Saves storage.</td>
        </tr>

        <tr>
            <td>Example: CHAR(10)</td>
            <td>Example: VARCHAR(50)</td>
        </tr>
    </table>

    <hr>

    <h2>Question 6: Insert, Update and Delete</h2>

<pre>
INSERT INTO Employees VALUES
(1,'Rahul','HR',45000,'Chennai'),
(2,'Priya','IT',65000,'Bangalore'),
(3,'Arun','Finance',55000,'Chennai'),
(4,'Sneha','IT',70000,'Hyderabad'),
(5,'Kiran','Sales',50000,'Chennai');

UPDATE Employees
SET salary=60000
WHERE id=3;

DELETE FROM Employees
WHERE name='Rahul';
</pre>

    <hr>

    <h2>Question 7: Operators</h2>

<pre>
=        SELECT * FROM Employees WHERE department='IT';

>        SELECT * FROM Employees WHERE salary>50000;

<        SELECT * FROM Employees WHERE salary<50000;

>=       SELECT * FROM Employees WHERE salary>=60000;

<=       SELECT * FROM Employees WHERE salary<=50000;

!=       SELECT * FROM Employees WHERE city!='Chennai';

AND      SELECT * FROM Employees WHERE department='IT' AND salary>60000;

OR       SELECT * FROM Employees WHERE city='Chennai' OR city='Hyderabad';

IN       SELECT * FROM Employees WHERE department IN('IT','HR');

BETWEEN  SELECT * FROM Employees WHERE salary BETWEEN 40000 AND 70000;

LIKE     SELECT * FROM Employees WHERE name LIKE 'A%';
</pre>

    <hr>

    <h2>Question 8: Display Records</h2>

<pre>
Highest Salary:
SELECT * FROM Employees ORDER BY salary DESC LIMIT 1;

Lowest Salary:
SELECT * FROM Employees ORDER BY salary ASC LIMIT 1;

Top 5 Highest Salary:
SELECT * FROM Employees ORDER BY salary DESC LIMIT 5;

Sort by Name:
SELECT * FROM Employees ORDER BY name;
</pre>

    <hr>

    <h2>Question 9: WHERE vs HAVING</h2>

<table border="1" cellpadding="8">
<tr>
<th>WHERE</th>
<th>HAVING</th>
</tr>

<tr>
<td>Filters rows before GROUP BY.</td>
<td>Filters groups after GROUP BY.</td>
</tr>

<tr>
<td>SELECT * FROM Employees WHERE salary>50000;</td>
<td>SELECT department,AVG(salary)
FROM Employees
GROUP BY department
HAVING AVG(salary)>50000;</td>
</tr>

</table>

    <hr>

    <h2>Question 10: Aggregate Functions</h2>

<pre>
COUNT()
SELECT COUNT(*) FROM Employees;

SUM()
SELECT SUM(salary) FROM Employees;

AVG()
SELECT AVG(salary) FROM Employees;

MAX()
SELECT MAX(salary) FROM Employees;

MIN()
SELECT MIN(salary) FROM Employees;
</pre>

    <hr>

    <h2>Question 11: Department Report</h2>

<pre>
SELECT
department,
COUNT(*) AS EmployeeCount,
SUM(salary) AS TotalSalary,
AVG(salary) AS AverageSalary
FROM Employees
GROUP BY department;
</pre>

    <hr>

    <h2>Question 12: HAVING Clause</h2>

<pre>
SELECT department,COUNT(*)
FROM Employees
GROUP BY department
HAVING COUNT(*)>3;

SELECT department,AVG(salary)
FROM Employees
GROUP BY department
HAVING AVG(salary)>50000;
</pre>

    <hr>

    <h2>Question 13: String Functions</h2>

<pre>
UPPER(name)

LOWER(name)

LENGTH(name)

CONCAT(name,'-',department)

SUBSTRING(name,1,3)

REPLACE(city,'Chennai','Coimbatore')

LEFT(name,3)

RIGHT(name,3)

REVERSE(name)

TRIM(name)
</pre>

    <hr>

    <h2>Question 14: Date Functions</h2>

<pre>
SELECT CURDATE();

SELECT NOW();

SELECT YEAR(CURDATE());

SELECT MONTH(CURDATE());

SELECT DAY(CURDATE());

SELECT DATE_FORMAT(CURDATE(),'%d-%m-%Y');

SELECT DATEDIFF('2026-12-31','2026-08-04');
</pre>

    <hr>

    <h2>Question 15: Interview Challenge</h2>

<pre>
SELECT
department,
COUNT(*) as EmployeeCount,
SUM(salary) as TotalSalary,
AVG(salary) as AverageSalary,
MAX(salary) as HighestSalary,
MIN(salary) as LowestSalary
FROM Employees
WHERE salary>40000
AND city='Chennai'
GROUP BY department
HAVING COUNT(*)>2
AND AVG(salary)>60000
ORDER BY TotalSalary DESC
LIMIT 3;
</pre>

